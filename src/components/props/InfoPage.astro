---
const { items = [] } = Astro.props;

interface InfoPageItem {
  title: string;
  text_block_title?: string;
  page_content_grid?: { title: string; items: string[] }[];
  page_content: string[];
}
---

<section id="info_page" class="info_page">
  {
    items.map((item: InfoPageItem) => (
      <div class="info_page_container">
        <div class="info_page_header">
          <h2 class="base_title about_title info_title">{item.title}</h2>
          <button class="info_page_back" onclick="history.back()">
            <span class="info_page_hamburger" />
          </button>
        </div>

        <div class="info_page_content">
          {item.page_content_grid &&
            item.page_content_grid.map((grid) => (
              <h3 class="info_page_content_subtitle">{grid.title}</h3>
			  <ul class="info_page_ul checkmarked_points">
				{grid.items.map((bullet) => (
					<li class="checkmarked_points_item info_page_content_bullet">{bullet}</li>
				))}
			  </ul>
           ))}

          <h3 class="info_page_content_subtitle">{item.text_block_title}</h3>
          {item.page_content.map((content) => (
            <p class="info_page_paragraph">{content}</p>
          ))}
        </div>
      </div>
    ))
  }
</section>
