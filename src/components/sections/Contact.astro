---
import "../../styles/contact.css";
---

<section id="contact" class="contact">
	<div class="contact_container">
		<h2 class="base_title about_title">Contact Us</h2>
		<div class="contact_input_boxes">
			<input
				class="contact_input_box"
				type="text"
				placeholder="Name"
				required
			/>
			<input
				class="contact_input_box"
				type="email"
				placeholder="Email"
				required
			/>
			<textarea
				class="contact_input_box contact_message_input_box"
				placeholder="Message"
				required></textarea>
		</div>
		<button type="submit" class="btn btn--primary contact_btn">Send</button>
	</div>
</section>
