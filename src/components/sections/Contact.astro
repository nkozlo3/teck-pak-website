---
import "../../styles/global.css";
---

<section id="contact" class="contact">
  <div class="contact_container">
    <h2 class="base_title about_title">Contact Us</h2>
    <form id="contact-form" class="contact_input_boxes">
      <input
        type="text"
        name="_honey"
        class="honeys"
        autocomplete="off"
        tabindex="-1"
      />
      <input
        type="text"
        name="confirm_email"
        id="confirm_email"
        class="confirm_email"
        autocomplete="off"
        tabindex="-1"
        required
      />
      <input
        class="contact_input_box"
        type="text"
        name="name"
        placeholder="Name"
        required
      />
      <input
        class="contact_input_box"
        type="email"
        name="email"
        placeholder="Email"
        required
      />
      <textarea
        class="contact_input_box contact_message_input_box"
        name="message"
        placeholder="Message"
        required></textarea>
      <button
        id="submit-button"
        type="submit"
        class="btn btn--primary contact_btn">Send</button
      >
    </form>
  </div>
</section>

<script>
  const CAPTCHA_ = "TECKPAC_VERIFIED_2026";
  document.addEventListener("DOMContentLoaded", () => {
    const confirm_email = document.getElementById(
      "confirm_email",
    ) as HTMLInputElement;
    if (confirm_email) {
      confirm_email.value = CAPTCHA_;
    }

    const form = document.getElementById("contact-form") as HTMLFormElement;
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);

      const data = {
        name: formData.get("name"),
        email: formData.get("email"),
        message: formData.get("message"),
        honey: formData.get("_honey"),
        confirm_email: formData.get("confirm_email"),
      };

      const button = document.getElementById("submit-button");
      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          form.reset();
          if (button) {
            button.textContent = "\u2714";

            setTimeout(() => {
              button.textContent = "Send";
            }, 3000);
          }
        } else {
          alert(
            "Message not sent. Please try again or email us at pdecleir@teckpac.com",
          );
        }
      } catch (err) {
        alert(
          "Network error. Please try again or email us at pdecleir@teckpac.com",
        );
      }
    });
  });
</script>
