---
const { pathname } = Astro.url;

const navLinks = [
  { name: "Solutions", href: "/solutions" },
  { name: "Case Studies", href: "/caseStudies" },
  { name: "Training", href: "/training" },
  { name: "Resources", href: "/resources" },
];
---

<header class="navbar">
  <div class="navbar_container">
    <!-- Logo! -->
    <a href="/" class="navbar_logo">
      <span class="navbar_logo_teck">Teck</span>Pac <span
        class="navbar_logo_teck">LC</span
      ></a
    >

    <!-- Hamburger -->
    <button
      id="navbar-toggle"
      class="navbar_toggle"
      aria-label="Open Menu"
      aria-expanded="false"
    >
      <span class="hamburger"></span>
    </button>

    <!-- Navigation Links -->
    <nav id="navbar-links" class="navbar_links">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "navbar_link",
                  {
                    active_navbar_link:
                      pathname === link.href ||
                      (link.href !== "/" && pathname.startsWith(link.href)),
                  },
                ]}
              >
                {link.name}
              </a>
            </li>
          ))
        }
        <li>
          <a id="navbar-about" href="/#about" class="navbar_link">About</a>
        </li>
        <li>
          <a id="navbar-contact" href="#contact" class="navbar_link deskt-btn"
            >Contact Us</a
          >
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("navbar-toggle");
  const menu = document.getElementById("navbar-links");
  const about = document.getElementById("navbar-about");
  const contact = document.getElementById("navbar-contact");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("open");
    toggle.classList.toggle("open");
    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
  });

  about?.addEventListener("click", () => {
    const alrOpen = menu?.classList.contains("open");
    if (alrOpen) {
      const isOpen = menu?.classList.toggle("open");
      toggle?.classList.toggle("open");
      toggle?.setAttribute("aria-expanded", isOpen ? "true" : "false");
    }
  });

  contact?.addEventListener("click", () => {
    const alrOpen = menu?.classList.contains("open");
    if (alrOpen) {
      const isOpen = menu?.classList.toggle("open");
      toggle?.classList.toggle("open");
      toggle?.setAttribute("aria-expanded", isOpen ? "true" : "false");
    }
  });
</script>
