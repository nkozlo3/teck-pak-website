---
import "../../styles/global.css";
import InfoPage from "../../components/props/InfoPage.astro";
const content = [
  {
    title: "Taste & Odor Issues with Kettle Case Study",
    page_content: [
      "Worked with an off-shore supplier to audit their production facilities and upstream suppliers of colorants, silicone resins and polypropylenes to address taste and odor issues in a multi-material, multi-component kettle. Made recommendations to improve the quality practices materials storage and molding processes. Quality control measures included the implementation of a odor test to identify and control the sources. Result: odors eliminated",
    ],
    text_block_title: "More Info",
    page_content_grid: [
      {
        title: "Problem",
        items: [
          "Off-taste and odor in multi-component kettle product",
          "Multiple materials and suppliers involved",
        ],
      },
      {
        title: "Investigation",
        items: [
          "Audited offshore production facility",
          "Reviewed upstream suppliers (colorants, silicone, polypropylene)",
          "Evaluated material handling and molding processes",
        ],
      },
      {
        title: "Root Cause",
        items: [
          "Material quality inconsistencies",
          "Poor storage and handling practices",
        ],
      },
      {
        title: "The Solution & The Result",
        items: [
          "Improved material quality control practices",
          "Implemented odor testing protocols",
          "Optimized storage and processing conditions",
          "Odor and taste issues eliminated",
          "Improved product consistency and quality",
        ],
      },
    ],
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/teck-pac_logo.svg" />
    <title>Cracked-Closures Case-Study | Teck-Pac</title>
  </head>
  <body>
    <section
      id="caseStudy_cracked-closures_page"
      class="caseStudy_cracked-closures_page"
    >
      <InfoPage items={content} />
    </section>
  </body>
</html>
