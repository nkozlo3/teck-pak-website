---
import "../../styles/global.css";
import InfoPage from "../../components/props/InfoPage.astro";
const content = [
  {
    title: "Leakers in Cups & Tubs",
    page_content: [
      "Leakers are an ever present issue with cups and tubs. But they don’t need to be. TeckPac has worked on many different seal leaker issues on thermoformed and injection molded cups and tubs. The fix can often be redesign of the heater head, heater head material composition, elimination of contamination, a unique change to the carrier plate design in the filler, and many others. TeckPack has worked and fixed many such leakers. Tell us your challenge and see the solution.",
    ],
    text_block_title: "More Info",
    page_content_grid: [
      {
        title: "Common Challenges",
        items: [
          "Persistent seal leaks in cups and tubs",
          "Issues across thermoformed and injection molded formats",
        ],
      },
      {
        title: "Typical Root Causes",
        items: [
          "Heater head design limitations",
          "Material compatibility issues",
          "Contamination during sealing process",
          "Inefficiencies in carrier plate or filler design",
        ],
      },
      {
        title: "Solutions",
        items: [
          "Redesign of heater head and materials",
          "Process optimization to eliminate contamination",
          "Equipment modifications for improved sealing consistency",
          "Custom engineering solutions based on application",
        ],
      },
      {
        title: "Result",
        items: [
          "Significant reduction or elimination of leaks",
          "Improved product integrity and shelf life",
        ],
      },
    ],
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/teck-pac_logo.svg" />
    <title>Leakers Case-Study | Teck-Pac</title>
  </head>
  <body>
    <section id="caseStudy_leakers_page" class="caseStudy_leakers_page">
      <InfoPage items={content} />
    </section>
  </body>
</html>
