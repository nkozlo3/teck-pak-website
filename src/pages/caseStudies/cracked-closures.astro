---
import "../../styles/global.css";
import InfoPage from "../../components/props/InfoPage.astro";
const content = [
  {
    title: "Cracked Closures Case Study",
    page_content: [
      "TeckPac LC learned that client was experiencing  severe cracking in closures in customers stores leading to a high level of returns. The problem was occurring in many different products from juices to sports drinks to iced teas and was a recent occurrence.",
      "TeckPac LCk conducted an investigation including a deep assessment of what changed. Investigation included Injection Molding Parameters, Capping Torques, Part Design to identify stress points and sharp angles, Environmental Stress Crack (ESCR) assessment, and Resin grade and changes.",
      "The assessment showed that multiple attributes were driving the cause. However, one overpowering change was identified and was enough to overshadow all the other limitations and fix the issue in a timely manner.",
    ],
    text_block_title: "More Info",
    page_content_grid: [
      {
        title: "Problem",
        items: [
          "Severe cracking in closures at retail",
          "High product return rates across multiple beverages",
          "Issue appeared suddenly across product lines",
        ],
      },
      {
        title: "Investigation",
        items: [
          "Reviewed injection molding parameters",
          "Analyzed capping torques and application conditions",
          "Evaluated part design for stress points and sharp angles",
          "Conducted ESCR (Environmental Stress Crack Resistance) testing",
          "Assessed resin grades and recent material changes",
        ],
      },
      {
        title: "Root Cause",
        items: [
          "Multiple contributing factors identified",
          "One key change isolated as primary driver of failure",
        ],
      },
      {
        title: "The Solution & The Result",
        items: [
          "Corrected the critical change",
          "Addressed secondary contributing factors",
          "Eliminated closure cracking issue",
          "Reduced returns and stabilized product performance",
        ],
      },
    ],
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/teck-pac_logo.svg" />
    <title>Cracked-Closures Case-Study | Teck-Pac</title>
  </head>
  <body>
    <section
      id="caseStudy_cracked-closures_page"
      class="caseStudy_cracked-closures_page"
    >
      <InfoPage items={content} />
    </section>
  </body>
</html>
