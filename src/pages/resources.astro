---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/teck-pac_logo.svg" />
    <title>Resources | Teck-Pac LC</title>
  </head>
  <body>
    <Header />
    <div class="links_container">
      {
        links_bucket.map((link_list) => (
          <div class="link_list_container">
            <h3 class="link_title">{link_list.title}</h3>
            <ul>
              {link_list.links.map((link) => (
                <li>
                  <a target="_blank" href={link.url}>
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <Contact />
  </body>
</html>
