---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import FloatingPage from "../components/props/FloatingPage.astro";
import Contact from "../components/sections/Contact.astro";

const solutions = [
  {
    title: "Carbonated Beverages, Soft Bottles",
    description_mobile:
      "Client reached out about taste and soft bottles. Initial investigation showed loss of carbonation over time. A deeper investigation showed defects at the top of the finish of the bottle causing ripples in the plug seal. The source of the preform defects was identified and corrected.",
    description:
      "Client reached out about taste and soft bottles. Initial investigation showed that filling carbonation levels and torques were in specification yet over time there was a loss in carbonation as indicated by soft bottles. A deeper dive showed defects at the top of finish of the bottle. Further analysis showed that the preform defects were causing ripples in the plug seal. The source of the preform defects was identified and corrected.",
    subtitle_alt: "Overview",
    points: [
      "Customers calling client about taste and soft bottles",
      "Conducted a thorough investigation",
      "Investigation showed burrs or ripples on the plug seal",
      "Source of the preform defects identified and corrected",
      "Happy ending, happy customers!",
    ],
    image: {
      src: "/soft_bottles_case-study.png",
      alt: "Deformed top of a soft bottle",
    },
    image_loading: "eager",
    button_href: "/caseStudies/soft-bottles",
  },
  {
    title: "Carbonated Beverages, Cracked Closures",
    description_mobile:
      "Client was experiencing severe cracking in closures leading to a high level of returns. The problem was occurring in many different products. Our investigation identified the root cause and fixed the issue in a timely manner.",
    description:
      "Client was experiencing severe cracking in closures in customers stores leading to a high level of returns. The problem was occurring in many different products from juices to sports drinks to iced teas and was a recent occurrence. TeckPack conducted an investigation including a deep assessment of what changed. Our investigation identified the root cause and fixed the issue in a timely manner.",
    subtitle_alt: "Overview",
    points: [
      "Severe cracking in closures, high level of returns",
      "Conducted a thorough investigation including a deep assessment",
      "Investigation identified the major root cause",
      "Source of the issue identified and corrected",
    ],
    image: {
      src: "/cracked_closures_case-study.png",
      alt: "Cracked bottle cap on a bottle",
    },
    image_loading: "eager",
    button_href: "/caseStudies/cracked-closures",
  },
  {
    title: "Taste & Odor Issue In Electric Water Kettle",
    description_mobile:
      "Worked with an off-shore supplier to audit their production facilities and suppliers to address taste and odor issues in a kettle. Made recommendations to improve the quality practices, storeage, and molding processes. Resulted in odors eliminated.",
    description:
      "Worked with an off-shore supplier to audit their production facilities and upstream suppliers of colorants, silicone resins and polypropylenes to address taste and odor issues in a multi-material, multi-component kettle. Made recommendations to improve the quality practices materials storage and molding processes. Quality control measures included the implementation of a odor test to identify and control the sources. Result: odors eliminated.",
    subtitle_alt: "Overview",
    points: [
      "Taste & Odor Issues in Electric Water Kettle",
      "Worked with an off-shore supplier",
      "Conducted an audit of production facilities and upstream suppliers",
      "Made recommendations to improve the quality practices, materials storage, and molding process",
      "Quality control measures included the implementation of an odor test to identify and control the sources",
      "Result: odors eliminated",
    ],
    image: {
      src: "/odor_kettle_case-study.png",
      alt: "A disassembled kettle",
    },
    image_loading: "lazy",
    button_href: "/caseStudies/kettle",
  },
  {
    title: "Leakers in Cups & Tubs",
    description_mobile:
      "Leakers are an ever present issue with cups and tubs. But they don’t need to be. TeckPac has worked on many different seal leaker issues on thermoformed and injection molded cups and tubs. Tell us your challenge and see the solution.",
    description:
      "Leakers are an ever present issue with cups and tubs. But they don’t need to be. TeckPac has worked on many different seal leaker issues on thermoformed and injection molded cups and tubs. The fix can often be redesign of the heater head, heater head material composition, elimination of contamination, a unique change to the carrier plate design in the filler, and many others. TeckPack has worked and fixed many such leakers. Tell us your challenge and see the solution.",
    subtitle_alt: "Overview",
    points: [
      "Issues with leaking in cups and tubs",
      "TeckPac has worked on many different seal leaker issues",
      "The problem -- and the fix -- are seldom the same",
      "Tell us your challenge and see the solution",
    ],
    image: {
      src: "/leakers_case-study.png",
      alt: "A yogurt with a leaking top",
    },
    image_loading: "lazy",
    button_href: "/caseStudies/leakers",
  },
  {
    title: "Silicone Tube and Spout for Bev. Dispenser",
    description_mobile:
      "TeckPack used their knowledge of polymer compositions to convince converter to increase catalyst percent in a silicone tubing and reduce the tube length to eliminate kinking in a peristaltic pump.",
    description:
      "The manufacture of silicone components is often considered by suppliers to be an art rather than a science. This is not always the case. TeckPack used their knowledge of polymer compositions to convince converter to increase catalyst percent in a silicone tubing and reduce the tube length to eliminate kinking in a peristaltic pump.",
    subtitle_alt: "Overview",
    points: [
      "Kinking in a peristaltic pump",
      "Recommended to repositioned the gate on HDPE injection molded valve",
      "Changed the resin grade to eliminate stress cracking",
      "The changes were implemented and eliminated cracks and kinked tubes!",
    ],
    image: {
      src: "/tube-spout_case-study.png",
      alt: "A silicone tube and its parts",
    },
    image_loading: "lazy",
    button_href: "/caseStudies/silicone-tube",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Case Studies | Teck-Pac</title>
  </head>
  <body>
    <Header />
    <div class="floating_page_wrapper">
      <FloatingPage items={solutions} />
    </div>
    <Contact />
  </body>
</html>
