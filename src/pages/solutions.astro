---
import "../styles/global.css";
import "../styles/solutions.css";
import "../styles/floatingPage.css";
import Header from "../components/layout/Header.astro";
import FloatingPage from "../components/props/FloatingPage.astro";

const solutions = [
	{
		title: "Trusted Experience in Food & Beverage Packaging",
		subtitle: "Piaras De Cleir, Founder",
		description_mobile:
			"With 25+ years of experience, dozens of successful case studies and product launches, we specialize in solving complex food and beverage packaging challenges. From defect analysis to rapid commercialization to comprehensive training TeckPac is ready to help.",
		description:
			"With 25+ years of experience, TeckPac brings technical expertise to all aspects of packaging. We’ve supported everything from launches to solving complex field failures, including carbonation loss, stress cracking, and sealing defects. Our approach goes beyond surface-level fixes to identify root causes and implement lasting solutions. In addition to troubleshooting and development, we offer comprehensive training programs covering everything from resin selection to closure performance. TeckPac helps teams move faster, reduce risk, and build packaging that performs in the real world.",
		subtitle_alt: "Here's What We Do",
		points: [
			"Diagnose & solve packaging defects and quality issues",
			"Launch products from concept to commercialization with speed-to-market and minimized expenditure",
			"Comprehensive training on closures, best practices, and more",
		],
		image: {
			src: "/teck-pak-website/piaras_headshot.jpg",
			alt: "Piaras Headshot",
		},
		button_href: "/teck-pak-website/solutions/kool-aid",
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Solutions | Teck-Pac</title>
	</head>
	<body>
		<Header />
		<div class="floating_page_wrapper">
			<FloatingPage items={solutions} />
		</div>
	</body>
</html>
