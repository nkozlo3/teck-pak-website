---
import "../../styles/global.css";
import InfoPage from "../../components/props/InfoPage.astro";
const content = [
  {
    title: "Jello Mold Easter Eggs",
    page_content: [
      "Worked through multiple technical and molding challenges to optimize various Easter Egg concepts under constrained timelines - addressed tolerance requirements to meet contrasting requirements such as a leak free fit and easy opening, resin requirements to handle boiling water, and molding challenges.",
    ],
    text_block_title: "More Info",
    page_content_grid: [
      {
        title: "Challenge",
        items: [
          "Conflicting design requirements: leak-proof seal vs. easy opening",
          "Material needed to withstand boiling water conditions",
          "Tight timelines with multiple evolving product concepts",
        ],
      },
      {
        title: "Approach",
        items: [
          "Optimized part tolerances to balance sealing performance and usability",
          "Selected and validated resin capable of handling high temperatures",
          "Addressed molding constraints to ensure consistent part quality",
        ],
      },
      {
        title: "Result",
        items: [
          "Delivered functional designs that met both sealing and usability requirements",
          "Ensured durability under real-world use conditions",
          "Successfully advanced multiple concepts under compressed timelines",
        ],
      },
    ],
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/teck-pac_logo.svg" />
    <title>Jello-Mold | Teck-Pac</title>
  </head>
  <body>
    <section id="solutions_jello_page" class="solutions_jello_page">
      <InfoPage items={content} />
    </section>
  </body>
</html>
