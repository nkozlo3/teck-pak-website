---
import "../../styles/global.css";
import InfoPage from "../../components/props/InfoPage.astro";
const content = [
  {
    title: "Improved Coffee Pods",
    page_content: [
      'Developed a New Coffee Pod with an improved filtration mechanism. Identified a new equipment supplier to develop a "quick" production filler for regional launch, while commercial line was being produced.',
    ],
    text_block_title: "More Info",
    page_content_grid: [
      {
        title: "Challenge",
        items: [
          "Need for improved filtration performance in coffee pods",
          "Requirement to support a rapid regional product launch",
          "Commercial-scale production line not yet available",
        ],
      },
      {
        title: "Approach",
        items: [
          "Developed a new pod design with enhanced filtration mechanism",
          "Identified and qualified an alternative equipment supplier",
          "Implemented a temporary production solution for early-stage launch",
        ],
      },
      {
        title: "Result",
        items: [
          "Improved product performance through enhanced filtration",
          "Enabled fast regional market entry ahead of full-scale production",
          "Bridged gap between development and commercial manufacturing",
        ],
      },
    ],
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/teck-pac_logo.svg" />
    <title>Coffee-Pods | Teck-Pac</title>
  </head>
  <body>
    <section id="solutions_coffe-pod_page" class="solutions_coffe-pod_page">
      <InfoPage items={content} />
    </section>
  </body>
</html>
